#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h> // for OUT_TOG

&kscan0 {
    debounce-press-ms = <1>;
    debounce-release-ms = <1>;
};

/ {
    macros {  // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/macros
        ALT_F9: ALT_F9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp F9>
                , <&macro_release &kp LEFT_ALT> ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &kp ESC &studio_unlock                &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 1       &kp G &kp G &kp J &kp J
            >;
        };

        functions { // Layer 1
            bindings = <
                &kp NUMBER_1 &studio_unlock                           &to 3      &kp NUMBER_2
                &kp F10 &kp LSHIFT &kp UP &kp DOWN &kp LEFT &kp RIGHT &kp RSHIFT &kp F11
                &to 0           &kp SPACE &kp A    &kp TAB  &kp ENTER
            >;
        };

        layers { // Layer 2
            bindings = <
                &to 0 &to 1                         &to 0 &to 0
                &to 3 &to 4 &to 5 &to 6 &to 7 &to 8 &to 9 &to 10
                &to 0       &none &none &none &none 
            >;
        };
        
        normal_layout { // Layer 3
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp A   &kp S &kp D &kp F &kp J &kp K &kp L   &kp SEMICOLON
                &to 1       &kp V &kp V &kp N &kp N
            >;
        };

        daily_usage { // Layer 4
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp A   &kp X &kp C &kp V &kp Z &kp N &kp HOME &kp END
                &to 2  &kp LCTRL &kp LALT &kp LGUI &kp LSHIFT
            >;
        };

        user_define_layer1 { // Layer 5
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };

        user_define_layer2 { // Layer 6
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };

        user_define_layer3 { // Layer 7
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };

        user_define_layer4 { // Layer 8
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };

        user_define_layer5 { // Layer 9
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };

        user_define_layer6 { // Layer 10
            bindings = <
                &kp ESC &none                         &ALT_F9 &kp GRAVE
                &kp W   &kp E &kp R &kp T &kp U &kp I &kp O   &kp P
                &to 2         &kp G &kp G &kp J &kp J
            >;
        };
    };
};